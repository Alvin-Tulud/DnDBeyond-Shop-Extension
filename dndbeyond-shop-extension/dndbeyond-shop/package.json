{
  "name": "dndbeyond-shop-keeper",
  "version": "1.0.0",
  "private": true,
  "description": "Unofficial DnD Beyond shop-list Chrome extension. Not affiliated with D&D Beyond, Wizards of the Coast, or Hasbro.",
  "scripts": {
    "build:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind-output.css --minify",
    "watch:css": "tailwindcss -i ./css/tailwind-input.css -o ./css/tailwind-output.css --watch",
    "vendor:jquery": "node -e \"require('fs').copyFileSync('node_modules/jquery/dist/jquery.min.js', 'js/jquery.min.js')\"",
    "postinstall": "npm run vendor:jquery && npm run build:css",
    "build": "npm run vendor:jquery && npm run build:css",
    "fetch:srd": "node js/fetch-srd.js",
    "fetch:srd52": "node js/fetch-srd.js --edition=2024",
    "merge:srd": "node js/fetch-srd.js --merge",
    "merge:srd52": "node js/fetch-srd.js --edition=2024 --merge"
  },
  "devDependencies": {
    "jquery": "^4.0.0",
    "tailwindcss": "^3.4.19"
  }
}
